# --- セキュリティ (絶対に必要) ---
# 認証キー
gcp-key.json
.env

# --- Go 関連 ---
# ビルドで生成される実行ファイル
/app
/main
*.exe
*.test

# 💡 gRPC / Protocol Buffers のGo側自動生成コード
internal/handler/grpc/pb/*
!internal/handler/grpc/pb/.gitkeep

# (参考) OpenAPIからコードを毎回自動生成して上書きする運用にする場合は以下も除外
# internal/handler/api.gen.go

# 依存関係（通常は go.mod/sum があれば不要）
# Goのツール
vendor/

# --- Python 関連 (★追加) ---
# ローカルの仮想環境を絶対にコミットしない
**/venv/
**/.venv/
**/env/

# gRPCの自動生成コードはMakefileで生成するためGit管理外にする
python_rag_worker/app/pb/*
!python_rag_worker/app/pb/.gitkeep

# Pythonのキャッシュ
**/__pycache__/
**/*.pyc

# --- Docker 関連 ---
# コンテナ内のデータがホスト側にマウントされるディレクトリ
# これをコミットすると、テストで使ったゴミファイルが他人の環境に混ざります
storage/

# --- 開発用の一時ファイル ---
*.log

# --- Terraform 関連 (機密情報とバイナリ) ---
# プラグインなどの実行バイナリ
.terraform/

# インフラの現在の状態（State）
# これを上げると他の人が実行した時に競合したり、機密が漏れたりします
*.tfstate
*.tfstate.*

# 依存関係のロックファイル（チーム開発でなければ無視してOK）
.terraform.lock.hcl

# --- システム/エディタ (環境を汚さない) ---
# --- 開発用の一時ファイル / エディタ ---
*.log
test.txt
.vscode/
.idea/
.DS_Store
Thumbs.db
